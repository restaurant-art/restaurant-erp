DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
DATABASE_URL=postgres://vestano:vestano@localhost:5432/vestano
# AWS deployments may omit DATABASE_URL and provide all five split values instead.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SECRET_ARN=
# Production image includes the AWS RDS trust store at this path:
# DATABASE_SSL_ROOT_CERT=/app/certs/rds-global-bundle.pem
DATABASE_SSL_REQUIRE=False
REDIS_URL=redis://localhost:6379/0

# Keep this false for local filesystem storage. In AWS, enable it explicitly or
# omit the flag and set AWS_STORAGE_BUCKET_NAME to auto-enable private S3 media.
USE_S3_STORAGE=False
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
AWS_QUERYSTRING_EXPIRE=3600

# Optional private CloudFront delivery. All three values are required together;
# use \\n inside the private key when the environment only supports one line.
AWS_S3_CUSTOM_DOMAIN=
AWS_CLOUDFRONT_KEY_ID=
AWS_CLOUDFRONT_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
